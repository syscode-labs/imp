{
  "annotations": {"list": []},
  "description": "Imp workload view. Select a namespace and VM to see the capacity and lifecycle signals that Imp currently publishes.",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["imp", "workload", "microvm"],
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Imp workloads",
  "uid": "imp-workloads-v1",
  "version": 1,
  "templating": {"list": [
    {"name": "datasource", "label": "Data source", "type": "datasource", "query": "prometheus", "refresh": 1, "current": {}},
    {"name": "namespace", "label": "Namespace", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(imp_vm_state, namespace)", "query": {"query": "label_values(imp_vm_state, namespace)", "refId": "NamespaceVariableQuery"}, "includeAll": true, "allValue": ".*", "multi": false, "refresh": 2, "current": {}},
    {"name": "vm", "label": "VM", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(imp_vm_state{namespace=~\"$namespace\"}, impvm)", "query": {"query": "label_values(imp_vm_state{namespace=~\"$namespace\"}, impvm)", "refId": "VMVariableQuery"}, "includeAll": true, "allValue": ".*", "multi": false, "refresh": 2, "current": {}}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Selected VM state", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0}, "targets": [{"refId": "A", "expr": "sum(imp_vm_state{namespace=~\"$namespace\",impvm=~\"$vm\"} == 1) or vector(0)"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 2, "type": "stat", "title": "Runtime ready", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0}, "targets": [{"refId": "A", "expr": "min(imp_runtime_ready) or vector(0)"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}},
    {"id": 3, "type": "stat", "title": "VMs running", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0}, "targets": [{"refId": "A", "expr": "count(imp_vm_state{namespace=~\"$namespace\",state=\"Running\"} == 1) or vector(0)"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "VM state history", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "targets": [{"refId": "A", "expr": "imp_vm_state{namespace=~\"$namespace\",impvm=~\"$vm\"}", "legendFormat": "{{impvm}} · {{state}}"}], "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 5, "type": "timeseries", "title": "Boot latency p95", "description": "Current Imp boot histograms are fleet-wide, not per-workload.", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(imp_vm_boot_latency_seconds_bucket[5m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 1, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 6, "type": "timeseries", "title": "Scheduling latency p95", "description": "Current Imp scheduling histograms are fleet-wide, not per-workload.", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(imp_vm_scheduling_latency_seconds_bucket[5m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 1, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ]
}
