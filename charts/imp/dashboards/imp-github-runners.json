{
  "annotations": {
    "list": []
  },
  "description": "Runner VM infrastructure only. Select independently confirmed runner VM names. VM state does not prove GitHub registration, idle/busy state, job execution, or cleanup.",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": [
    "imp",
    "github",
    "runner",
    "microvm"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Imp GitHub runners",
  "uid": "imp-github-runners-v1",
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {}
      },
      {
        "name": "runner_vm",
        "label": "Runner VM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(imp_vm_state, impvm)",
        "query": {
          "query": "label_values(imp_vm_state, impvm)",
          "refId": "RunnerVMVariableQuery"
        },
        "includeAll": false,
        "multi": true,
        "refresh": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Runner VM infrastructure only.** Select independently confirmed runner VM names. VM state does not prove GitHub registration, idle/busy state, job execution, or cleanup."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Selected runner VM observations",
      "description": "No selected runner VM telemetry.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "imp_vm_state{impvm=~\"${runner_vm:regex}\"} == 1",
          "legendFormat": "{{impvm}} \u00b7 {{namespace}} \u00b7 {{node}} \u00b7 {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Selected runner VMs by state",
      "description": "No selected runner VM telemetry.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (imp_vm_state{impvm=~\"${runner_vm:regex}\"} == 1)",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
