{
  "annotations": {"list": []},
  "description": "Imp administrator view. Uses only Prometheus metrics emitted by Imp and works with any Prometheus-compatible Grafana datasource.",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["imp", "administrator", "microvm"],
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Imp administrator",
  "uid": "imp-admin-v1",
  "version": 1,
  "templating": {"list": [
    {"name": "datasource", "label": "Data source", "type": "datasource", "query": "prometheus", "refresh": 1, "current": {}},
    {"name": "namespace", "label": "Namespace", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "definition": "label_values(imp_vm_state, namespace)", "query": {"query": "label_values(imp_vm_state, namespace)", "refId": "NamespaceVariableQuery"}, "includeAll": true, "allValue": ".*", "multi": false, "refresh": 2, "current": {}}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Runtime ready", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "targets": [{"refId": "A", "expr": "min(imp_runtime_ready) or vector(0)"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}},
    {"id": 2, "type": "stat", "title": "Active VMs", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}, "targets": [{"refId": "A", "expr": "count(imp_vm_state{namespace=~\"$namespace\"} == 1) or vector(0)"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 3, "type": "stat", "title": "Running VMs", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}, "targets": [{"refId": "A", "expr": "count(imp_vm_state{namespace=~\"$namespace\",state=\"Running\"} == 1) or vector(0)"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 4, "type": "stat", "title": "Reconcile errors / second", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}, "targets": [{"refId": "A", "expr": "sum(rate(controller_runtime_reconcile_errors_total{controller=\"impvm\"}[5m])) or vector(0)"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none"}, "fieldConfig": {"defaults": {}, "overrides": []}},
    {"id": 5, "type": "timeseries", "title": "VM state", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "targets": [{"refId": "A", "expr": "sum by (state) (imp_vm_state{namespace=~\"$namespace\"})", "legendFormat": "{{state}}"}], "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 6, "type": "timeseries", "title": "Scheduling latency p95", "description": "All namespaces. Histograms currently have no namespace label.", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(imp_vm_scheduling_latency_seconds_bucket[5m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 1, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 7, "type": "timeseries", "title": "Boot latency p95", "description": "All namespaces. Histograms currently have no namespace label.", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(imp_vm_boot_latency_seconds_bucket[5m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 1, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 8, "type": "timeseries", "title": "Reconcile activity", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "targets": [{"refId": "A", "expr": "sum(rate(controller_runtime_reconcile_total{controller=\"impvm\"}[5m])) by (result)", "legendFormat": "{{result}}"}], "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "showPoints": "never"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ]
}
