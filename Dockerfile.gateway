# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS builder
WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY api/ api/
COPY cmd/sandbox-gateway/ cmd/sandbox-gateway/
COPY internal/ internal/

RUN CGO_ENABLED=0 GOOS=linux go build -o sandbox-gateway ./cmd/sandbox-gateway

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/sandbox-gateway .
USER 65532:65532
ENTRYPOINT ["/sandbox-gateway"]
